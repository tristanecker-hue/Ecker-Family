rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function mail() {
      return request.auth.token.email;
    }
    function uname() {
      return mail().split('@')[0];
    }
    function isTristan() {
      return signedIn() && mail() == 'tristan@ecker.ch';
    }
    // Wand-iPad: darf nur lesen (Aufgaben, Essen, freigegebene Kalender)
    function isPad() {
      return signedIn() && mail() == 'pad@ecker.ch';
    }
    function isFamily() {
      return signedIn() && mail() in [
        'tristan@ecker.ch',
        'claudia@ecker.ch',
        'lina@ecker.ch',
        'florian@ecker.ch'
      ];
    }

    // Freigaben aus den Einstellungen (Dokument settings/app).
    // Fehlt das Dokument noch, gelten die Standardwerte.
    function hasSettings() {
      return exists(/databases/$(database)/documents/settings/app);
    }
    function featureOn(feature, defaults) {
      return isFamily() && (isTristan()
        || (hasSettings() && uname() in get(/databases/$(database)/documents/settings/app).data.get(feature, defaults))
        || (!hasSettings() && uname() in defaults));
    }
    function isTimeUser() { return featureOn('zeit', ['tristan', 'claudia']); }
    function canTodo()    { return featureOn('todo', ['tristan', 'claudia', 'lina', 'florian']); }
    function canAssign()  { return featureOn('assign', ['tristan', 'claudia']); }
    function canPoints()  { return featureOn('punkte', ['tristan', 'claudia', 'lina', 'florian']); }
    function canMeals()   { return featureOn('essen', ['tristan', 'claudia', 'lina', 'florian']); }
    function canChat()    { return featureOn('chat', ['tristan', 'claudia', 'lina', 'florian']); }

    // Einstellungen: alle lesen, nur Tristan ändert
    match /settings/{id} {
      allow read: if isFamily();
      allow write: if isTristan();
    }

    // Zeiterfassung: wer freigeschaltet ist, sieht alle Einträge, ändert aber nur die eigenen
    match /entries/{id} {
      allow read: if isTimeUser();
      allow create: if isTimeUser() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTimeUser() && resource.data.uid == request.auth.uid;
    }

    // Feuerwehr: nur Tristan
    match /feuerwehr/{id} {
      allow read, write: if isTristan();
    }

    // To-Do's: Freigeschaltete lesen. Wer zuordnen darf, legt an und löscht.
    // Inhalt ändern (Text, Person, Datum) darf nur, wer die Pendenz erstellt hat.
    // "Erledigt" ein- und ausschalten darf, wer zuordnen darf, und die zugeordnete Person
    // (diese vermerkt ausserdem, dass sie die Pendenz gesehen hat).
    // Wand-iPad: Kinder-Pendenzen nur «gemeldet» (claimedAt), Pendenzen von Tristan/Claudia ohne Wiederholung erledigen.
    match /todos/{id} {
      allow read: if canTodo() || isPad();
      allow create: if canAssign();
      allow update: if
        (canAssign()
          && resource.data.createdByKey == uname()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'assigneeKey', 'dueAt', 'note', 'points', 'done', 'doneAt', 'claimedAt', 'remind', 'repeat']))
        || (canAssign()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneAt', 'claimedAt', 'seenAt']))
        || (canTodo()
          && mail() == resource.data.assigneeKey + '@ecker.ch'
          && resource.data.done == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedAt', 'seenAt']))
        || (isPad()
          && resource.data.done == false
          && resource.data.assigneeKey in ['lina', 'florian']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedAt']))
        || (isPad()
          && resource.data.done == false
          && resource.data.assigneeKey in ['tristan', 'claudia']
          && (!('repeat' in resource.data) || resource.data.repeat == null || resource.data.repeat == '')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneAt', 'claimedAt']))
        || (canTodo()
          && resource.data.assigneeKey == 'alle'
          && resource.data.done == false
          && request.resource.data.assigneeKey == uname()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assigneeKey']));
      allow delete: if canAssign();
    }

    // Sterne und Belohnungen: Dokument "catalog" (Belohnungen) ändern nur Eltern;
    // pro Kind (lina, florian): Eltern vergeben Bonus, das Kind löst selbst ein.
    match /rewards/{id} {
      allow read: if canPoints();
      allow create: if canPoints() && (canAssign() || (uname() == id && request.resource.data.keys().hasOnly(['redeemed'])));
      allow update: if canPoints() && (canAssign() || (uname() == id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemed'])));
      allow delete: if canAssign();
    }

    // Essen (Wochenplan): alle Freigeschalteten lesen, Eltern tragen ein
    match /meals/{id} {
      allow read: if canMeals() || isPad();
      allow write: if canAssign();
    }

    // Private Aufgaben: nur Tristan und Claudia sehen und ändern sie (eigene Sammlung, damit Kinder sie nie laden)
    match /todosPrivat/{id} {
      allow read, write: if canAssign() && uname() in ['tristan', 'claudia'];
    }

    // Familienchat: alle Freigeschalteten lesen und schreiben (nur als sich selbst).
    // Löschen: eigene Nachrichten; Tristan und Claudia löschen alle. Nachrichten sind unveränderbar.
    match /chat/{id} {
      allow read: if canChat();
      allow create: if canChat()
        && request.resource.data.keys().hasOnly(['from', 'name', 'text', 'at', 'photo', 'voice', 'dur'])
        && request.resource.data.from == uname()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && (request.resource.data.text.size() > 0 || request.resource.data.get('photo', null) is string || request.resource.data.get('voice', null) is string)
        && request.resource.data.get('dur', 0) is number
        && request.resource.data.at is number;
      allow update: if false;
      allow delete: if canChat() && (resource.data.from == uname() || uname() in ['tristan', 'claudia']);
    }

    // Chat-Fotos (komprimiert als Text gespeichert): lesen alle, löschen wie Nachrichten
    match /chatPhotos/{id} {
      allow read: if canChat();
      allow create: if canChat()
        && request.resource.data.keys().hasOnly(['from', 'data', 'at'])
        && request.resource.data.from == uname()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 950000
        && request.resource.data.at is number;
      allow update: if false;
      allow delete: if canChat() && (resource.data.from == uname() || uname() in ['tristan', 'claudia']);
    }

    // Zettel (Post-its, ersetzen den Chat): lesen Absender und Empfänger, das Pad nur Zettel an 'pad'.
    // Ändern: nur erledigt markieren. Löschen: Absender, Eltern, oder Empfänger bei Zetteln ohne Foto.
    match /zettel/{id} {
      allow read: if (canChat() && (resource.data.from == uname() || uname() in resource.data.to))
        || (isPad() && 'pad' in resource.data.to);
      allow create: if canChat()
        && request.resource.data.keys().hasOnly(['from', 'name', 'to', 'text', 'at', 'photo', 'color', 'size', 'font', 'done'])
        && request.resource.data.from == uname()
        && request.resource.data.to is list
        && request.resource.data.to.size() >= 1 && request.resource.data.to.size() <= 5
        && request.resource.data.to.hasOnly(['tristan', 'claudia', 'lina', 'florian', 'pad'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && (request.resource.data.text.size() > 0 || request.resource.data.get('photo', false) == true)
        && request.resource.data.at is number
        && request.resource.data.get('size', 'm') in ['s', 'm', 'l']
        && request.resource.data.get('font', 'n') in ['n', 'h', 'b', 't']
        && request.resource.data.done == false;
      allow update: if canChat()
        && (resource.data.from == uname() || uname() in resource.data.to || uname() in ['tristan', 'claudia'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneBy', 'doneAt']);
      allow delete: if canChat() && (resource.data.from == uname() || uname() in ['tristan', 'claudia']
        || (uname() in resource.data.to && resource.data.get('photo', false) == false));
    }

    // Zettel-Fotos (Dokument-ID = Zettel-ID): lesen wer den Zettel lesen darf
    match /zettelPhotos/{id} {
      allow read: if (canChat() && (resource.data.from == uname()
          || uname() in get(/databases/$(database)/documents/zettel/$(id)).data.to))
        || (isPad() && 'pad' in get(/databases/$(database)/documents/zettel/$(id)).data.to);
      allow create: if canChat()
        && request.resource.data.keys().hasOnly(['from', 'data', 'at'])
        && request.resource.data.from == uname()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 950000
        && request.resource.data.at is number;
      allow update: if false;
      allow delete: if canChat() && (resource.data.from == uname() || uname() in ['tristan', 'claudia']);
    }

    // Familienfotos für die Diashow am Wand-iPad: alle Familienmitglieder und das Pad lesen,
    // jede Person lädt eigene hoch und löscht eigene, Tristan löscht alle
    match /fotos/{id} {
      allow read: if isFamily() || isPad();
      allow create: if isFamily()
        && request.resource.data.keys().hasOnly(['from', 'data', 'at'])
        && request.resource.data.from == uname()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 950000
        && request.resource.data.at is number;
      allow update: if false;
      allow delete: if isFamily() && (resource.data.from == uname() || isTristan());
    }

    // Pad-Einstellungen (Diashow, Geburtstage, Nachtmodus): lesen Familie und Pad, ändern nur die Eltern
    match /padcfg/{id} {
      allow read: if isFamily() || isPad();
      allow write: if isTristan() || (signedIn() && mail() == 'claudia@ecker.ch');
    }

    // Spiele-Rekorde: alle lesen, jede Person schreibt nur die eigenen Bestwerte
    match /scores/{id} {
      allow read: if isFamily();
      allow write: if isFamily() && uname() == id;
    }

    // Push-Adressen: jede Person verwaltet nur ihre eigenen Geräte (versendet wird serverseitig)
    match /pushTokens/{id} {
      allow read, write: if isFamily() && uname() == id;
    }

    // Kalender: Tristan schreibt (Sync aus Google), gelesen wird nur, wer im Feld "allowed" steht
    match /calendars/{id} {
      allow read: if isTristan() || (isFamily() && uname() in resource.data.allowed) || (isPad() && 'pad' in resource.data.allowed);
      allow write: if isTristan();
    }

    // Spesen (Einträge, Belege, Kostenstellen): privat, nur die eigene Person (mit Zugriff auf Hauswart)
    match /spesen/{userId}/{sub}/{id} {
      allow read, write: if isTimeUser() && request.auth.uid == userId;
    }

    // Stundenpläne: Tristan und Claudia lesen und ändern alle, Kinder sehen nur den eigenen
    match /plans/{kid} {
      allow read: if isFamily() && (uname() in ['tristan', 'claudia'] || uname() == kid);
      allow write: if isFamily() && uname() in ['tristan', 'claudia'];
    }

    // Profile (Name + Profilbild): alle vier und das Pad (für Geburtstagsfotos) lesen, jeder schreibt nur sein eigenes
    match /profiles/{userId} {
      allow read: if isFamily() || isPad();
      allow write: if isFamily() && request.auth.uid == userId;
    }
  }
}
