rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function mail() {
      return request.auth.token.email;
    }
    function uname() {
      return mail().split('@')[0];
    }
    function isTristan() {
      return signedIn() && mail() == 'tristan@ecker.ch';
    }
    function isFamily() {
      return signedIn() && mail() in [
        'tristan@ecker.ch',
        'claudia@ecker.ch',
        'lina@ecker.ch',
        'florian@ecker.ch'
      ];
    }

    // Freigaben aus den Einstellungen (Dokument settings/app).
    // Fehlt das Dokument noch, gelten die Standardwerte.
    function hasSettings() {
      return exists(/databases/$(database)/documents/settings/app);
    }
    function featureOn(feature, defaults) {
      return isFamily() && (isTristan()
        || (hasSettings() && uname() in get(/databases/$(database)/documents/settings/app).data.get(feature, defaults))
        || (!hasSettings() && uname() in defaults));
    }
    function isTimeUser() { return featureOn('zeit', ['tristan', 'claudia']); }
    function canTodo()    { return featureOn('todo', ['tristan', 'claudia', 'lina', 'florian']); }
    function canAssign()  { return featureOn('assign', ['tristan', 'claudia']); }
    function canPoints()  { return featureOn('punkte', ['tristan', 'claudia', 'lina', 'florian']); }
    function canMeals()   { return featureOn('essen', ['tristan', 'claudia', 'lina', 'florian']); }

    // Einstellungen: alle lesen, nur Tristan ändert
    match /settings/{id} {
      allow read: if isFamily();
      allow write: if isTristan();
    }

    // Zeiterfassung: wer freigeschaltet ist, sieht alle Einträge, ändert aber nur die eigenen
    match /entries/{id} {
      allow read: if isTimeUser();
      allow create: if isTimeUser() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTimeUser() && resource.data.uid == request.auth.uid;
    }

    // Feuerwehr: nur Tristan
    match /feuerwehr/{id} {
      allow read, write: if isTristan();
    }

    // To-Do's: Freigeschaltete lesen. Wer zuordnen darf, legt an und löscht.
    // Inhalt ändern (Text, Person, Datum) darf nur, wer die Pendenz erstellt hat.
    // "Erledigt" ein- und ausschalten darf, wer zuordnen darf, und die zugeordnete Person
    // (diese vermerkt ausserdem, dass sie die Pendenz gesehen hat).
    match /todos/{id} {
      allow read: if canTodo();
      allow create: if canAssign();
      allow update: if
        (canAssign()
          && resource.data.createdByKey == uname()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'assigneeKey', 'dueAt', 'note', 'points', 'done', 'doneAt', 'claimedAt']))
        || (canAssign()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneAt', 'claimedAt', 'seenAt']))
        || (canTodo()
          && mail() == resource.data.assigneeKey + '@ecker.ch'
          && resource.data.done == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedAt', 'seenAt']));
      allow delete: if canAssign();
    }

    // Sterne und Belohnungen: Dokument "catalog" (Belohnungen) ändern nur Eltern;
    // pro Kind (lina, florian): Eltern vergeben Bonus, das Kind löst selbst ein.
    match /rewards/{id} {
      allow read: if canPoints();
      allow create: if canPoints() && (canAssign() || (uname() == id && request.resource.data.keys().hasOnly(['redeemed'])));
      allow update: if canPoints() && (canAssign() || (uname() == id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemed'])));
      allow delete: if canAssign();
    }

    // Essen (Wochenplan): alle Freigeschalteten lesen, Eltern tragen ein
    match /meals/{id} {
      allow read: if canMeals();
      allow write: if canAssign();
    }

    // Spesen (Einträge, Belege, Kostenstellen): privat, nur die eigene Person (mit Zugriff auf Hauswart)
    match /spesen/{userId}/{sub}/{id} {
      allow read, write: if isTimeUser() && request.auth.uid == userId;
    }

    // Stundenpläne: Tristan und Claudia lesen und ändern alle, Kinder sehen nur den eigenen
    match /plans/{kid} {
      allow read: if isFamily() && (uname() in ['tristan', 'claudia'] || uname() == kid);
      allow write: if isFamily() && uname() in ['tristan', 'claudia'];
    }

    // Profile (Name + Profilbild): alle vier lesen, jeder schreibt nur sein eigenes
    match /profiles/{userId} {
      allow read: if isFamily();
      allow write: if isFamily() && request.auth.uid == userId;
    }
  }
}
